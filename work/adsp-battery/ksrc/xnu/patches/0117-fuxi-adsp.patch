+}
+
+int qcom_mdt_split_read(const QcomMdtSplit *split, QcomMdtPieceRead read, void *context, uint64_t offset, void *to, size_t length)
+{
+    uint8_t *out = to;
+    if (!split || !read || !to || !fits(offset, length, split->size)) return QcomMdtOutside;
