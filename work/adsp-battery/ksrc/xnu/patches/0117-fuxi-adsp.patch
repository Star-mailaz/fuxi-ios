+++ b/bsd/dev/GeniI2c.c
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "GeniI2c.h"
+
+static uint32_t rd(GeniI2c *g, uint32_t reg) {return g->io.read(g->io.ctx, reg);}
+static void wr(GeniI2c *g, uint32_t reg, uint32_t value) {g->io.write(g->io.ctx, reg, value);}
+
+/* A FIFO depth field (bits 21:16); a field that reads zero takes the smallest depth these engines have. */
+static uint32_t fifo_words(uint32_t param)
+{
+    const uint32_t words = (param >> 16) & 0x3fu;
+    return words ? words : 16u;
+}
+
+int geni_i2c_prepare(GeniI2c *g, const GeniIo *io, uint8_t address, uint32_t *config)
+{
+    for (unsigned i = 0; i < sizeof *g; ++i) ((uint8_t *)g)[i] = 0;
+    g->io = *io;
+    g->address = address;
+    const uint32_t proto = (rd(g, GENI_FW_REVISION) >> 8) & 0xffu, clock = rd(g, GENI_CLK_CFG);
+    if (config) *config = (proto << 24) | (clock & 0xffffffu);
+    if (proto != GENI_PROTO_I2C || (rd(g, GENI_IF_DISABLE) & 1u) || !(clock & 1u) || !rd(g, GENI_SCL_COUNTERS)) return -1;
+    wr(g, GENI_DMA_MODE, 0);
+    /* 8-bit words, 4 per FIFO word, least significant byte first on the wire. */
+    wr(g, GENI_TX_PACK0, 0x7f8fe); wr(g, GENI_TX_PACK1, 0xffefe);
+    wr(g, GENI_RX_PACK0, 0x7f8fe); wr(g, GENI_RX_PACK1, 0xffefe);
+    wr(g, GENI_BYTE_GRAN, 0);
+    wr(g, GENI_TX_WATERMARK, 0);
+    g->tx_fifo_words = fifo_words(rd(g, GENI_HW_PARAM_0));
+    g->rx_fifo_words = fifo_words(rd(g, GENI_HW_PARAM_1));
+    wr(g, GENI_M_IRQ_CLEAR, 0xffffffffu);
+    /* Exactly the bits this core handles: one the boot loader left enabled (RX watermark, RX last) would hold the level line up. */
+    wr(g, GENI_M_IRQ_EN, GENI_M_IRQ_WANTED);
+    wr(g, GENI_SE_IRQ_EN, rd(g, GENI_SE_IRQ_EN) | GENI_SE_M_IRQ_EN);
+    return 0;
+}
+
+/* Starts one write command of length bytes (at most 8); the data goes in when the engine asks for it (TX watermark). */
+static void write_command(GeniI2c *g, const uint8_t *bytes, uint32_t length, int hold)
+{
+    g->tx[0] = g->tx[1] = 0;
+    for (uint32_t i = 0; i < length; ++i) g->tx[i / 4] |= (uint32_t)bytes[i] << (8 * (i % 4));
+    g->tx_words = (uint8_t)((length + 3) / 4);
+    g->length = length;
+    g->hold = (uint8_t)hold;
+    wr(g, GENI_TX_LEN, length);
+    wr(g, GENI_M_CMD0, (GENI_OP_WRITE << 27) | ((uint32_t)g->address << 9) | (hold ? GENI_STOP_STRETCH : 0));
+    wr(g, GENI_TX_WATERMARK, 1);
+    g->phase = GeniTxWait;
+}
+
+int geni_i2c_start_write(GeniI2c *g, uint8_t reg, uint8_t value)
+{
+    if (g->phase != GeniIdle) return -1;
+    g->reading = 0; g->reg = reg; g->value = value; g->error = GeniOk;
+    const uint8_t bytes[2] = {reg, value};
+    write_command(g, bytes, 2, 0);
+    return 0;
+}
+
+int geni_i2c_start_read(GeniI2c *g, uint8_t reg)
+{
+    if (g->phase != GeniIdle) return -1;
+    g->reading = 1; g->rx_length = 1; g->reg = reg; g->error = GeniOk;
+    write_command(g, &reg, 1, 1);
+    return 0;
+}
+
+int geni_i2c_start_write_bytes(GeniI2c *g, const uint8_t *bytes, uint32_t length)
+{
+    if (g->phase != GeniIdle || !length || length > 8) return -1;
+    g->reading = 0; g->error = GeniOk;
+    write_command(g, bytes, length, 0);
+    return 0;
+}
+
+int geni_i2c_start_read_bytes(GeniI2c *g, const uint8_t *bytes, uint32_t length, uint32_t read_length)
+{
+    if (g->phase != GeniIdle || !length || length > 4 || !read_length || read_length > 4) return -1;
+    g->reading = 1; g->rx_length = (uint8_t)read_length; g->error = GeniOk;
+    write_command(g, bytes, length, 1);
+    return 0;
+}
+
+int geni_i2c_start_write_buffer(GeniI2c *g, const uint8_t *bytes, uint32_t length)
+{
+    if (g->phase != GeniIdle || !bytes || !length) return -1;
+    g->reading = 0; g->error = GeniOk;
+    g->tx_buffer = bytes; g->tx_done = 0;
+    g->tx_words = 0;
+    g->length = length;
+    g->hold = 0;
+    wr(g, GENI_TX_LEN, length);
+    wr(g, GENI_M_CMD0, (GENI_OP_WRITE << 27) | ((uint32_t)g->address << 9));
+    wr(g, GENI_TX_WATERMARK, 1);
+    g->phase = GeniTxWait;
+    return 0;
+}
+
+int geni_i2c_start_read_buffer(GeniI2c *g, const uint8_t *command, uint32_t command_length, uint8_t *buffer, uint32_t length)
+{
+    if (g->phase != GeniIdle || !command || !command_length || command_length > 8 || !buffer || !length) return -1;
+    g->reading = 1; g->error = GeniOk;
+    g->rx_buffer = buffer; g->rx_done = 0; g->rx_total = length;
+    write_command(g, command, command_length, 1);
+    return 0;
+}
+
+/* Fills the free TX FIFO words (a watermark event that finds the FIFO full writes nothing); the last word in ends the TX wait. */
+static void feed(GeniI2c *g)
+{
+    const uint32_t used = GENI_TX_FIFO_WORDS(rd(g, GENI_TX_FIFO_STATUS));
+    uint32_t room = used < g->tx_fifo_words ? g->tx_fifo_words - used : 0;
+    while (room && g->tx_done < g->length) {
+        uint32_t word = 0;
+        for (unsigned k = 0; k < 4 && g->tx_done < g->length; ++k) word |= (uint32_t)g->tx_buffer[g->tx_done++] << (8 * k);
+        wr(g, GENI_TX_FIFO, word);
+        --room;
+    }
+    if (g->tx_done == g->length) {
+        wr(g, GENI_TX_WATERMARK, 0);
+        g->phase = GeniWriteDone;
+    }
+}
+
+/* Empties the RX FIFO into the read buffer; words past the requested length are dropped. */
+static void drain(GeniI2c *g)
+{
+    for (uint32_t words = GENI_RX_FIFO_WORDS(rd(g, GENI_RX_FIFO_STATUS)); words; --words) {
+        const uint32_t word = rd(g, GENI_RX_FIFO);
+        for (unsigned k = 0; k < 4 && g->rx_buffer && g->rx_done < g->rx_total; ++k) g->rx_buffer[g->rx_done++] = (uint8_t)(word >> (8 * k));
+    }
+}
+
+static int finish(GeniI2c *g, int error, uint32_t status)
+{
+    g->phase = GeniIdle;
+    wr(g, GENI_TX_WATERMARK, 0);
+    if (g->rx_buffer) {
+        /* A failed or cancelled read can leave words behind; the next transfer must not take them. */
+        if (error) {uint8_t *keep = g->rx_buffer; g->rx_buffer = 0; drain(g); g->rx_buffer = keep;}
+        wr(g, GENI_M_IRQ_EN, GENI_M_IRQ_WANTED);
+    }
+    g->tx_buffer = 0; g->rx_buffer = 0;
+    if (!error) {g->done++; return GeniDone;}
+    g->error = (uint8_t)error;
+    g->error_status = status;
+    g->failed++;
+    return GeniFailed;
+}
+
+int geni_i2c_event(GeniI2c *g, uint32_t status)
+{
+    if (!status) return GeniPending;
+    switch (g->phase) {
+    case GeniIdle:
+        g->stray++;
+        return GeniPending;
+    case GeniCancelling:
+        if (status & GENI_M_CMD_CANCEL) return finish(g, GeniErrTimeout, g->error_status);
+        return GeniPending;
+    case GeniAborting:
+        if (status & GENI_M_CMD_ABORT) return finish(g, GeniErrTimeout, g->error_status);
+        return GeniPending;
+    default:
+        break;
+    }
+    /* A failed command also ends with CMD_DONE; the error bits decide. */
+    if (status & GENI_M_ERRORS) return finish(g, GeniErrBus, status);
+    if (g->phase == GeniTxWait) {
+        if ((status & GENI_M_TX_WATERMARK) && g->tx_buffer) feed(g);
+        else if (status & GENI_M_TX_WATERMARK) {
+            for (unsigned i = 0; i < g->tx_words; ++i) wr(g, GENI_TX_FIFO, g->tx[i]);
+            wr(g, GENI_TX_WATERMARK, 0);
+            g->phase = GeniWriteDone;
+        }
+        if (!(status & GENI_M_CMD_DONE)) return GeniPending;
+        if (g->phase == GeniTxWait) return finish(g, GeniErrState, status);  /* done before the data went in */
+    }
+    if (g->phase == GeniReadDone && g->rx_buffer) {
+        drain(g);
+        if (!(status & GENI_M_CMD_DONE)) return GeniPending;
+        drain(g);   /* the last words can land after the status was read */
+        return g->rx_done == g->rx_total ? finish(g, GeniOk, 0) : finish(g, GeniErrNoData, status);
+    }
+    if (!(status & GENI_M_CMD_DONE)) return GeniPending;
+    if (g->phase == GeniWriteDone) {
+        if (!g->reading) return finish(g, GeniOk, 0);
+        if (g->rx_buffer) {
+            const uint32_t mark = g->rx_fifo_words > 1 ? g->rx_fifo_words - 1 : 1;
+            wr(g, GENI_RX_WATERMARK, mark);
+            wr(g, GENI_RX_RFR_WATERMARK, g->rx_fifo_words);
+            wr(g, GENI_M_IRQ_EN, GENI_M_IRQ_WANTED | GENI_M_RX_WATERMARK | GENI_M_RX_LAST);
+            wr(g, GENI_RX_LEN, g->rx_total);
+        } else wr(g, GENI_RX_LEN, g->rx_length);
+        wr(g, GENI_M_CMD0, (GENI_OP_READ << 27) | ((uint32_t)g->address << 9));
+        g->phase = GeniReadDone;
+        return GeniPending;
+    }
+    /* GeniReadDone */
+    if (!(rd(g, GENI_RX_FIFO_STATUS) & 0x1ffffffu)) return finish(g, GeniErrNoData, status);
+    g->rx = rd(g, GENI_RX_FIFO);
+    g->data = (uint8_t)g->rx;
+    return finish(g, GeniOk, 0);
+}
+
+int geni_i2c_poll(GeniI2c *g)
+{
+    const uint32_t status = rd(g, GENI_M_IRQ_STATUS);
+    if (status) wr(g, GENI_M_IRQ_CLEAR, status);
+    return g->phase == GeniIdle ? GeniPending : geni_i2c_event(g, status);
+}
+
+int geni_i2c_timeout(GeniI2c *g)
+{
+    switch (g->phase) {
+    case GeniIdle:
+        return GeniPending;
+    case GeniCancelling:
+        wr(g, GENI_M_CMD_CTRL, GENI_CMD_CTRL_ABORT);
+        g->phase = GeniAborting;
+        return GeniPending;
+    case GeniAborting:
+        return finish(g, GeniErrTimeout, g->error_status);
+    default:
+        g->timeouts++;
+        g->error_status = rd(g, GENI_M_IRQ_STATUS);
+        wr(g, GENI_TX_WATERMARK, 0);
+        wr(g, GENI_M_CMD_CTRL, GENI_CMD_CTRL_CANCEL);
+        g->phase = GeniCancelling;
+        return GeniPending;
+    }
+}
--- /dev/null
+++ b/bsd/dev/fuxi_bt.c
@@ -0,0 +1,394 @@
+#include "fuxi_bt.h"
+#include <string.h>
+
+struct fuxi_bt_parser {
+    uint8_t header[5];
+    uint8_t event[258];
+    unsigned header_size;
+    unsigned header_need;
+    unsigned body_size;
+    unsigned body_need;
+};
+
+static uint16_t fuxi_bt_le16(const uint8_t *bytes)
+{
+    return (uint16_t)((uint16_t)bytes[0] | (uint16_t)bytes[1] << 8);
+}
+
+static uint32_t fuxi_bt_le32(const uint8_t *bytes)
+{
+    return (uint32_t)bytes[0] | (uint32_t)bytes[1] << 8 |
+        (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+const char *fuxi_bt_status_name(enum fuxi_bt_status status)
+{
+    static const char *const names[] = {
+        "ok", "off", "argument", "no-uart", "busy", "again", "io",
+        "timeout", "budget", "protocol", "controller", "legacy",
+        "ibs", "version", "cleanup"
+    };
+    if ((unsigned)status >= sizeof(names) / sizeof(names[0])) {
+        return "unknown";
+    }
+    return names[status];
+}
+
+bool fuxi_bt_uart_ops_valid(const struct fuxi_bt_uart_ops *ops)
+{
+    return ops && ops->acquire && ops->write && ops->read &&
+        ops->release && ops->now_us && ops->wait_us;
+}
+
+static enum fuxi_bt_status fuxi_bt_event(const uint8_t *event,
+    unsigned size, struct fuxi_bt_result *result)
+{
+    const uint8_t code = event[1];
+    const unsigned payload = event[2];
+    if (code == 0xff && payload >= 2 && event[3] == 0 && event[4] == 2) {
+        return FUXI_BT_LEGACY;
+    }
+    if (code == 0x0f) {
+        if (payload != 4) {
+            return FUXI_BT_PROTOCOL;
+        }
+        if (fuxi_bt_le16(event + 5) == 0xfc00) {
+            result->controller_status = event[3];
+            if (event[3]) {
+                return FUXI_BT_CONTROLLER;
+            }
+        }
+    }
+    if (code == 0x0e) {
+        if (payload < 3) {
+            return FUXI_BT_PROTOCOL;
+        }
+        if (fuxi_bt_le16(event + 4) == 0xfc00) {
+            if (payload == 4 && event[6]) {
+                result->controller_status = event[6];
+                return FUXI_BT_CONTROLLER;
+            }
+            if (payload != 18 || size != sizeof(result->reply)) {
+                return FUXI_BT_PROTOCOL;
+            }
+            memcpy(result->reply, event, size);
+            result->reply_size = size;
+            if (event[6] != 0 || event[7] != 0x19) {
+                return FUXI_BT_PROTOCOL;
+            }
+            /*
+             * WCN3991 以後的版本回應放在 Command Complete：event[6]=cresp(0)、event[7]=rtype(0x19)，
+             * event[8] 是多出的一個位元組，版本資料從 event[9] 起。Linux btqca.c qca_read_soc_version
+             * 對 soc_type >= QCA_WCN3991 用 memcpy(ver, edl->data + 1, ...) 直接略過它、不當狀態碼；
+             * 2026-11-17 WCN7850 實機回 0x0c（等於 12 位元組版本資料長度），之前誤判成 Command Disallowed。
+             */
+            result->version.product = fuxi_bt_le32(event + 9);
+            result->version.patch = fuxi_bt_le16(event + 13);
+            result->version.rom = fuxi_bt_le16(event + 15);
+            result->version.soc = fuxi_bt_le32(event + 17);
+            if (!result->version.soc || !result->version.rom) {
+                return FUXI_BT_VERSION;
+            }
+            result->version_valid = true;
+            return FUXI_BT_OK;
+        }
+    }
+    result->ignored_frames++;
+    return FUXI_BT_AGAIN;
+}
+
+static enum fuxi_bt_status fuxi_bt_receive(struct fuxi_bt_parser *parser,
+    const uint8_t *bytes, size_t size, struct fuxi_bt_result *result)
+{
+    for (size_t index = 0; index < size; index++) {
+        const uint8_t byte = bytes[index];
+        if (!parser->header_size) {
+            switch (byte) {
+                case 2:
+                case 5:
+                    parser->header_need = 5;
+                    break;
+                case 3:
+                    parser->header_need = 4;
+                    break;
+                case 4:
+                    parser->header_need = 3;
+                    break;
+                case 0xfc:
+                case 0xfd:
+                case 0xfe:
+                    return FUXI_BT_IBS;
+                default:
+                    return FUXI_BT_PROTOCOL;
+            }
+        }
+        if (parser->header_size < parser->header_need) {
+            parser->header[parser->header_size++] = byte;
+            if (parser->header_size != parser->header_need) {
+                continue;
+            }
+            if (parser->header[0] == 4) {
+                parser->body_need = parser->header[2];
+                memcpy(parser->event, parser->header, parser->header_need);
+            } else if (parser->header[0] == 3) {
+                parser->body_need = parser->header[3];
+            } else {
+                parser->body_need = fuxi_bt_le16(parser->header + 3);
+                if (parser->header[0] == 5) {
+                    parser->body_need &= 0x3fffu;
+                }
+            }
+            if (parser->body_need > FUXI_BT_MAX_RX) {
+                return FUXI_BT_BUDGET;
+            }
+        } else {
+            if (parser->header[0] == 4) {
+                parser->event[parser->header_need + parser->body_size] = byte;
+            }
+            parser->body_size++;
+        }
+        if (parser->body_size == parser->body_need) {
+            enum fuxi_bt_status status = FUXI_BT_AGAIN;
+            if (++result->frames > FUXI_BT_MAX_FRAMES) {
+                return FUXI_BT_BUDGET;
+            }
+            if (parser->header[0] == 4) {
+                status = fuxi_bt_event(parser->event,
+                    parser->header_need + parser->body_need, result);
+            } else {
+                result->ignored_frames++;
+            }
+            memset(parser, 0, sizeof(*parser));
+            if (status != FUXI_BT_AGAIN) {
+                return status;
+            }
+        }
+    }
+    return FUXI_BT_AGAIN;
+}
+
+static enum fuxi_bt_status fuxi_bt_time_check(
+    const struct fuxi_bt_uart_ops *ops, uint64_t start,
+    struct fuxi_bt_result *result)
+{
+    const uint64_t now = ops->now_us(ops->context);
+    if (now < start || now - start < result->elapsed_us) {
+        return FUXI_BT_IO;
+    }
+    result->elapsed_us = now - start;
+    if (result->elapsed_us >= FUXI_BT_TIMEOUT_US) {
+        return FUXI_BT_TIMEOUT;
+    }
+    return FUXI_BT_OK;
+}
+
+static enum fuxi_bt_status fuxi_bt_drain(
+    const struct fuxi_bt_uart_ops *ops, uint64_t start,
+    struct fuxi_bt_result *result)
+{
+    uint8_t bytes[64];
+    for (unsigned attempt = 0; attempt < FUXI_BT_MAX_DRAIN; attempt++) {
+        size_t count = 0;
+        const unsigned remaining = FUXI_BT_MAX_DRAIN - result->drained_bytes;
+        const size_t capacity = remaining < sizeof(bytes) ? remaining : sizeof(bytes);
+        enum fuxi_bt_status status = fuxi_bt_time_check(ops, start, result);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+        if (!capacity) {
+            return FUXI_BT_BUDGET;
+        }
+        status = ops->read(ops->context, bytes, capacity, &count);
+        if (count > capacity || (status != FUXI_BT_OK && count)) {
+            return FUXI_BT_IO;
+        }
+        if (status == FUXI_BT_AGAIN || (status == FUXI_BT_OK && !count)) {
+            return FUXI_BT_OK;
+        }
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+        if (count > FUXI_BT_MAX_DRAIN - result->drained_bytes) {
+            return FUXI_BT_BUDGET;
+        }
+        result->drained_bytes += (unsigned)count;
+    }
+    return FUXI_BT_BUDGET;
+}
+
+enum fuxi_bt_status fuxi_bt_probe_run(unsigned opt_in,
+    const struct fuxi_bt_uart_ops *ops, struct fuxi_bt_result *result)
+{
+    static const uint8_t command[] = {1, 0, 0xfc, 1, 0x19};
+    struct fuxi_bt_parser parser = {0};
+    uint8_t bytes[64];
+    uint64_t start;
+    enum fuxi_bt_status status;
+    if (!result) {
+        return FUXI_BT_ARGUMENT;
+    }
+    memset(result, 0, sizeof(*result));
+    result->status = FUXI_BT_OFF;
+    if (!opt_in) {
+        return result->status;
+    }
+    if (opt_in != 1) {
+        result->status = FUXI_BT_ARGUMENT;
+        return result->status;
+    }
+    if (!fuxi_bt_uart_ops_valid(ops)) {
+        result->status = FUXI_BT_NO_UART;
+        return result->status;
+    }
+    start = ops->now_us(ops->context);
+    status = ops->acquire(ops->context, FUXI_BT_BOOT_BAUD);
+    if (status != FUXI_BT_OK) {
+        goto finish;
+    }
+    status = fuxi_bt_drain(ops, start, result);
+    if (status != FUXI_BT_OK) {
+        goto finish;
+    }
+    for (unsigned attempt = 0; attempt < FUXI_BT_MAX_POLLS; attempt++) {
+        size_t count = 0;
+        result->polls++;
+        status = fuxi_bt_time_check(ops, start, result);
+        if (status != FUXI_BT_OK) {
+            goto finish;
+        }
+        if (result->tx_bytes < sizeof(command)) {
+            const size_t remaining = sizeof(command) - result->tx_bytes;
+            status = ops->write(ops->context, command + result->tx_bytes,
+                remaining, &count);
+            if (count > remaining || (status != FUXI_BT_OK && count)) {
+                status = FUXI_BT_IO;
+                goto finish;
+            }
+            if (status != FUXI_BT_OK && status != FUXI_BT_AGAIN) {
+                goto finish;
+            }
+            result->tx_bytes += (unsigned)count;
+        }
+        if (result->tx_bytes == sizeof(command)) {
+            const unsigned remaining = FUXI_BT_MAX_RX - result->rx_bytes;
+            const size_t capacity = remaining < sizeof(bytes) ? remaining : sizeof(bytes);
+            status = fuxi_bt_time_check(ops, start, result);
+            if (status != FUXI_BT_OK) {
+                goto finish;
+            }
+            if (!capacity) {
+                status = FUXI_BT_BUDGET;
+                goto finish;
+            }
+            count = 0;
+            status = ops->read(ops->context, bytes, capacity, &count);
+            if (count > capacity || (status != FUXI_BT_OK && count)) {
+                status = FUXI_BT_IO;
+                goto finish;
+            }
+            if (status != FUXI_BT_OK && status != FUXI_BT_AGAIN) {
+                goto finish;
+            }
+            if (count > FUXI_BT_MAX_RX - result->rx_bytes) {
+                status = FUXI_BT_BUDGET;
+                goto finish;
+            }
+            result->rx_bytes += (unsigned)count;
+            status = fuxi_bt_time_check(ops, start, result);
+            if (status != FUXI_BT_OK) {
+                goto finish;
+            }
+            status = fuxi_bt_receive(&parser, bytes, count, result);
+            if (status != FUXI_BT_AGAIN) {
+                goto finish;
+            }
+        }
+        ops->wait_us(ops->context, 1000);
+    }
+    status = FUXI_BT_TIMEOUT;
+
+finish:
+    if (status == FUXI_BT_AGAIN) {
+        status = FUXI_BT_IO;
+    }
+    {
+        const enum fuxi_bt_status timing = fuxi_bt_time_check(ops, start, result);
+        if (status == FUXI_BT_OK && timing != FUXI_BT_OK) {
+            status = timing;
+        }
+    }
+    result->status = status;
+    result->cleanup = ops->release(ops->context);
+    if (result->status == FUXI_BT_OK && result->cleanup != FUXI_BT_OK) {
+        result->status = FUXI_BT_CLEANUP;
+    }
+    return result->status;
+}
+
+enum fuxi_bt_status fuxi_bt_snapshot_read(fuxi_bt_read32_fn read32,
+    void *context, struct fuxi_bt_snapshot *snapshot)
+{
+    static const uint32_t branches[] = {0x233d4, 0x233d0, 0x233cc, 0x23004, 0x1e754};
+    static const uint32_t rcg[] = {0x1e760, 0x1e764, 0x1e768, 0x1e76c, 0x1e770, 0x1e774};
+    static const uint32_t engine[] = {0x68, 0x64, 0x40, 0x610, 0x640};
+    uint32_t *engine_values[5];
+    enum fuxi_bt_status status;
+    if (!read32 || !snapshot) {
+        return FUXI_BT_ARGUMENT;
+    }
+    memset(snapshot, 0, sizeof(*snapshot));
+    status = read32(context, FUXI_BT_GCC_BASE + 0x52010, &snapshot->vote);
+    if (status != FUXI_BT_OK) {
+        return status;
+    }
+    status = read32(context, FUXI_BT_GCC_BASE + 0x52018, &snapshot->gpll0_vote);
+    if (status != FUXI_BT_OK) {
+        return status;
+    }
+    for (unsigned index = 0; index < 5; index++) {
+        status = read32(context, FUXI_BT_GCC_BASE + branches[index], &snapshot->branches[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+        if (snapshot->branches[index] & (1u << 31)) {
+            snapshot->off_mask |= 1u << index;
+        }
+    }
+    for (unsigned index = 0; index < 6; index++) {
+        status = read32(context, FUXI_BT_GCC_BASE + rcg[index], &snapshot->rcg[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+    }
+    for (unsigned index = 0; index < 8; index++) {
+        const uint64_t pin = FUXI_BT_TLMM_BASE + (uint64_t)(76 + index) * 0x1000;
+        status = read32(context, pin, &snapshot->pin_ctl[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+        status = read32(context, pin + 4, &snapshot->pin_io[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+    }
+    if (snapshot->off_mask) {
+        return FUXI_BT_OK;
+    }
+    status = read32(context, FUXI_BT_WRAPPER_BASE + 4, &snapshot->wrapper_version);
+    if (status != FUXI_BT_OK) {
+        return status;
+    }
+    engine_values[0] = &snapshot->firmware;
+    engine_values[1] = &snapshot->interface_disable;
+    engine_values[2] = &snapshot->engine_status;
+    engine_values[3] = &snapshot->master_irq;
+    engine_values[4] = &snapshot->secondary_irq;
+    for (unsigned index = 0; index < 5; index++) {
+        status = read32(context, FUXI_BT_UART_BASE + engine[index], engine_values[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+    }
+    snapshot->engine_read = true;
+    return FUXI_BT_OK;
+}
