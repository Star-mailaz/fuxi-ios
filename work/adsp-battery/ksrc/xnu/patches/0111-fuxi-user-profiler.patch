+  unsigned best=SP_EDGE_BUCKETS;
+  for(unsigned i=0;i<SP_EDGE_BUCKETS;i++)if(sp_edges[i].n && (best==SP_EDGE_BUCKETS || sp_edges[i].n>sp_edges[best].n))best=i;
