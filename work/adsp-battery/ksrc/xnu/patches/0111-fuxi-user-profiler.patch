+  printf("PROFEDGE %c 0x%llx 0x%llx %u\n","LWR?"[(sp_edges[best].a>>60)&3],(unsigned long long)(sp_edges[best].a&(((uint64_t)1<<60)-1)),(unsigned long long)sp_edges[best].b,sp_edges[best].n);
